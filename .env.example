# Optional Formspree override. When blank, the on-page contact form uses FormSubmit
# with the email in src/data/portfolio.ts. Activate it once from the owner's inbox.
# To use Formspree instead, create a form with a verified notification recipient.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Optional custom reCAPTCHA v3 public site key, if enabled for this Formspree form.
# Configure its SECRET only in Formspree, never in this website or in Git.
NEXT_PUBLIC_FORMSPREE_RECAPTCHA_SITE_KEY=

# Preferred production origin. Override if the assigned domain changes.
NEXT_PUBLIC_SITE_URL=https://gabrielpaclibar.vercel.app
